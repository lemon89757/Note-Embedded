                <mxCell id="09sxp9gIbGO0tz_i0cMy-26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="4GB virtual memory space,&amp;nbsp;&lt;div&gt;shared between user space processs, the kernel, and hardware devices&lt;/div&gt;" vertex="1">
                    <mxGeometry height="30" width="520" x="535" y="-240" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="it becomes necessary to reserve certain regions of VM space for use for new facilities;&lt;div&gt;therefore this document may reserve more VM space over time&lt;/div&gt;" vertex="1">
                    <mxGeometry height="30" width="530" x="-420" y="435" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;CPU vector page.&lt;/font&gt;&lt;/b&gt;&lt;div&gt;The CPU vectors are mapped here if the CPU supports vector relocation (control register V bit)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="30" width="570" x="490" y="15" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="DTCM mapping area for platforms with&lt;div&gt;DTCM mounted inside the CPU.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="30" width="250" x="520" y="75" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-30" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="ITCM mapping area for platforms with&lt;div&gt;ITCM mounted inside the CPU&lt;/div&gt;" vertex="1">
