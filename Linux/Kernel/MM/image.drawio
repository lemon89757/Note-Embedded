                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-32" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="XScale cache flush area.&amp;nbsp;&lt;div&gt;This is used in proc-xscale.S to flush the whole data cache. (XScale does not have TCM)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="30" width="480" x="-360" y="105" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-33" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Fixmap mapping region.&lt;div&gt;Address provided by &lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;fix_to_virt()&lt;/font&gt;&lt;/b&gt; will be located here.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="30" width="330" x="515" y="255" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-34" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Mapping of PCI I/O space.&lt;div&gt;This is a static mapping within the vmalloc space.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="30" width="310" x="525" y="375" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-35" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;vmalloc() / ioremap() space.&lt;/font&gt;&lt;/b&gt;&lt;div&gt;Memory returned by vmalloc/ioremap will be dynamically placed in this region.&lt;/div&gt;&lt;div&gt;Machine specific static mappings are also located here through iotable_init().&lt;/div&gt;&lt;div&gt;VMALLOC_START is based upon the value of the high_memory variable,&amp;nbsp;&lt;/div&gt;&lt;div&gt;and VMALLOC_END is equal to 0xff000000&lt;/div&gt;" vertex="1">
                    <mxGeometry height="110" width="445" x="552.5" y="455" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-36" parent="1" style="shape=crossbar;whiteSpace=wrap;html=1;rounded=1;direction=south;" value="" vertex="1">
                    <mxGeometry height="180" width="20" x="120" y="360" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="VMALLOC_START" vertex="1">
                    <mxGeometry height="30" width="100" x="10" y="520" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-38" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="VMALLOC_END" vertex="1">
                    <mxGeometry height="30" width="100" x="10" y="345" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-39" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Kernel direct-mapped RAM region.&lt;/font&gt;&lt;/b&gt;&lt;div&gt;This maps the platfroms RAM, and typically maps all platform RAM in a 1:1 relationship&lt;/div&gt;" vertex="1">
                    <mxGeometry height="30" width="515" x="517.5" y="615" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-40" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Permanent kernel mappings&lt;div&gt;One way of mapping &lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;HIGHMEM&lt;/font&gt;&lt;/b&gt; pages into kernel space.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="30" width="380" x="585" y="675" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-41" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Kernel module space&lt;/font&gt;&lt;/b&gt;&lt;div&gt;Kernel modules inserted via insmod are placed here using dynamic mappings&lt;/div&gt;" vertex="1">
                    <mxGeometry height="30" width="450" x="550" y="795" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-42" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;User space mappings&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&amp;nbsp;Per-thread mappings are placed here via the mmap() system call&lt;/div&gt;" vertex="1">
                    <mxGeometry height="30" width="380" x="585" y="915" as="geometry"/>
                </mxCell>
                <mxCell id="09sxp9gIbGO0tz_i0cMy-43" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="CPU vector page / null pointer trap&amp;nbsp;&lt;div&gt;CPUs which do not support vector remapping place their vector page here.&lt;/div&gt;&lt;div&gt;NULL pointer dereferences by both the kernel and user space are also caught via this mapping.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="65" width="610" x="500" y="957.5" as="geometry"/>
                </mxCell>
