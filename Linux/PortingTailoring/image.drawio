                <mxCell id="zPBDHpfH6a97GSw9BV1H-49" value="包含 BCB, Bootloader Control Block&lt;div&gt;主要用于 Android/Linux 系统、U-Boot 以及 recovery 之间的通信&lt;br&gt;U-Boot 阶段会读取 misc 分区中的 BCB 数据，从而判读是进入正常系统，还是 recovery 模式&lt;/div&gt;&lt;div&gt;misc.img 镜像都是预编译好的，位于 /device/rockchip/rockimg/ 目录下&lt;/div&gt;&lt;div&gt;当前使用的 misc.img 镜像由板级配置文件 device/rockchip/rk356x/BoardConfig-rk3568-atk-evb1-ddr4-v10.mk 的 RK_MISC 变量决定&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="-2220" y="430" width="720" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="zPBDHpfH6a97GSw9BV1H-50" value="&lt;span style=&quot;text-wrap-mode: wrap;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;boot.img&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
