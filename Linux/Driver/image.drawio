                <mxCell id="SdJhUramouSj6XcGL0od-0" value="device_add()" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="xYATpmPg7jRQwkN4eaz2-1" vertex="1">
