                    <mxGeometry x="1697" y="371" width="210" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="266" value="if (kobj-&amp;gt;name) kfree(name)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="1697" y="392" width="170" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="267" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1674" y="317" width="20" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="268" value="" style="shape=flexArrow;endArrow=classic;html=1;" parent="1" edge="1">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="580" y="268.07512195121944" as="sourcePoint"/>
                        <mxPoint x="660" y="268.9200000000001" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="269" value="" style="shape=flexArrow;endArrow=classic;html=1;entryX=-0.004;entryY=0.62;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" target="256" edge="1">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="839" y="271.4951219512195" as="sourcePoint"/>
                        <mxPoint x="919" y="272.34000000000015" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="270" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="369" y="-45" width="20" height="315" as="geometry"/>
                </mxCell>
                <mxCell id="271" value="会初始化 dev 的引用计数为 1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="210" y="510" width="180" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="272" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="2760" y="-291" width="20" height="1690" as="geometry"/>
                </mxCell>
                <mxCell id="273" value="设备的注册与注销：" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="2790" y="252.75" width="130" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="274" value="&lt;ul&gt;&lt;li&gt;分开看待 dev 占有的内存和系统资源：&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;在设备模型中，内存回收和资源管理是解耦的&lt;/b&gt;&lt;/li&gt;&lt;li&gt;内存由 refcount 管理&lt;/li&gt;&lt;li&gt;系统资源由驱动及总线（总结就是内核）进行管理&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;系统资源：&lt;/li&gt;&lt;ul&gt;&lt;li&gt;sysfs 入口、总线占用、驱动占用、devres 相关资源&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;devres 机制&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;devres 绑定的是“设备在系统中的生命周期”，而非“结构体内存”。devres (device resource) 的设计语义是：当设备从系统中分离（detach/unbind）时，自动清理资源。这与 struct device 结构体何时被 kfree 是完全不同的概念&lt;/b&gt;&lt;/li&gt;&lt;li&gt;devres 为驱动服务，不是为设备注册服务的。&lt;b&gt;是“驱动管理资源”的机制&lt;/b&gt;&lt;/li&gt;&lt;li&gt;注册时，在驱动相关代码中参与，由驱动动态分配系统资源给 dev&lt;/li&gt;&lt;li&gt;注销时，由 device_del() 触发，当驱动从 dev 上剥离时（bus-&amp;gt;remove/drv-&amp;gt;remove 后），回收 attach 在 dev 上的系统资源，此时 devres 机制发挥作用&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;注册：&lt;/li&gt;&lt;ul&gt;&lt;li&gt;内存申请（可以先由内核代码申请），并初始化 refcount 等（device_initialize）&lt;/li&gt;&lt;li&gt;device_add() - sysfs 入口、总线注册、驱动绑定、devres 资源&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;注销：&lt;/li&gt;&lt;ul&gt;&lt;li&gt;注销不等于销毁&lt;/li&gt;&lt;li&gt;device_del()-在设备注销时，从 sysfs、总线、驱动等子系统中移除。设备不再对系统可见。&lt;/li&gt;&lt;li&gt;put_device()-减少引用计数，当引用计数归零时，释放 struct device 内存。设备对象可以安全销毁。&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;verticalAlign=middle;overflow=hidden;" parent="1" vertex="1">
                    <mxGeometry x="2780" y="274.5" width="360" height="575.5" as="geometry"/>
                </mxCell>
                <mxCell id="275" value="" style="shape=flexArrow;endArrow=classic;html=1;exitX=0.667;exitY=0.05;exitDx=0;exitDy=0;exitPerimeter=0;" parent="1" source="274" edge="1">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="3100" y="303" as="sourcePoint"/>
                        <mxPoint x="3210" y="303.5" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="276" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="3210" y="269.75" width="20" height="67" as="geometry"/>
                </mxCell>
                <mxCell id="277" value="注册分为两步：" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="3230" y="253.25" width="110" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="278" value="注销分为两步：" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="3230" y="322.25" width="110" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="279" value="对应处理：" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="3120" y="309.75" width="80" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="280" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="3310" y="251.25" width="20" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="281" value="申请内存，初始化 refcount" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="3330" y="235.25" width="170" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="283" value="关联到系统中，占用系统资源（attach）" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="3330" y="269.75" width="240" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="284" value="释放 dev 占用的系统资源（detach）" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="3330" y="308.25" width="220" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="285" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="3310" y="321.25" width="20" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="286" value="可继续留存在内存中，&lt;div&gt;但当 refcount 等于 0 时释放内存&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="3330" y="334.75" width="190" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="287" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="3540" y="283" width="20" height="46.5" as="geometry"/>
                </mxCell>
                <mxCell id="288" value="都涉及资源操作的&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;内核代码&lt;/span&gt;：&lt;div&gt;总线相关、驱动相关代码都有&lt;/div&gt;&lt;div&gt;attach 系统资源到 dev 上（注册时），&lt;/div&gt;&lt;div&gt;detach 系统资源从 dev 上（注销时）&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="3560" y="271.25" width="230" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="289" value="driver_init(void)：" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="-205" y="2459.5" width="120" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="290" value="内核启动时，执行此函数：/drivers/base/init.c&lt;div&gt;driver_init - initialize driver model.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Call the driver model init functions to initialize their subsystem.&lt;/div&gt;&lt;div&gt;Called early from init/main.c&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="-195" y="2480.5" width="350" height="90" as="geometry"/>
                </mxCell>
