                    </mxGeometry>
                </mxCell>
                <mxCell id="292" value="struct kset *devices_set 初始化" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="130" y="2459.5" width="190" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="293" value="" style="endArrow=classic;html=1;exitX=0.429;exitY=0.893;exitDx=0;exitDy=0;exitPerimeter=0;" parent="1" edge="1">
