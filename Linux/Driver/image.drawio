                <mxCell id="sGwANn9fhr24MS4b6R0B-15" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;device_initialize()&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="xYATpmPg7jRQwkN4eaz2-1" vertex="1">
