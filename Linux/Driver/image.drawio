                    <mxGeometry x="260" y="1390" width="190" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="UxGxgJsvDRrmLheRHbKh-1" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="220" y="1045" width="20" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="UxGxgJsvDRrmLheRHbKh-2" value="标志位，分别对应 kobject 的状态：&lt;div&gt;是否已初始化&lt;/div&gt;&lt;div&gt;是否已已注册到 sysfs&lt;/div&gt;&lt;div&gt;是否已发送 add uevent&amp;nbsp;&lt;/div&gt;&lt;div&gt;是否已发送 remove uevent&lt;/div&gt;&lt;div&gt;是否允许发送 uevent&amp;nbsp;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="30" y="1090" width="200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="frxaH_8E7h7kfFFWXcBv-1" value="&lt;ul&gt;&lt;li&gt;找到 kobject 对应的 kset&lt;/li&gt;&lt;li&gt;根据 kset-&amp;gt;uevent_ops 的 filter 等判断是否不需要发送该事件&lt;/li&gt;&lt;li&gt;通过 kset-&amp;gt;uevent_ops-&amp;gt;name 回调获得子系统名（否则是 kset-&amp;gt;kobj-&amp;gt;name）会用作环境变量，添加其他环境变量，调用 kset-&amp;gt;uevent_ops-&amp;gt;uevent 回调增加子系统定义的环境变量&lt;/li&gt;&lt;li&gt;根据事件类型置位 kobj 的相关标志位&lt;/li&gt;&lt;li&gt;另起进程调用用户空间程序完成事件的响应工作&lt;/li&gt;&lt;/ul&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;verticalAlign=middle;overflow=hidden;" parent="1" vertex="1">
                    <mxGeometry x="2007" y="855" width="510" height="153" as="geometry"/>
                </mxCell>
                <mxCell id="frxaH_8E7h7kfFFWXcBv-2" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="2007" y="875" width="20" height="120" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
