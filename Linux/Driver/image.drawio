                    </mxGeometry>
                </mxCell>
                <mxCell id="295" value="const struct kset_uevent_ops *uevent_ops 字段" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
