                <mxCell id="236" value="pm_runtime_get_sync(dev)&lt;div&gt;driver_sysfs_remove(dev)&lt;/div&gt;&lt;div&gt;if (dev-&amp;gt;bus)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;blocking_notifier_call_chain(&amp;amp;dev-&amp;gt;bus-&amp;gt;p-&amp;gt;bus_notifyer, BUS_NOTIFY_UNBIND_DRIVER, dev)&lt;br&gt;&lt;/div&gt;&lt;div&gt;pm_runtime_put_sync(dev)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
