                <mxCell id="122" value="int __driver_attach(struct device *dev, void *data)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="1810" y="1562" width="280" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="123" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="2070" y="1517" width="20" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="124" value="判断 driver 和 device 是否匹配：&lt;br&gt;int driver_match_device(struct device_driver *drv, struct device *dev);" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="2090" y="1517" width="390" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="125" value="匹配的话返回非 0 值" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="2320" y="1574" width="130" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="126" value="函数内容：drv-&amp;gt;bus-&amp;gt;match() ? drv-&amp;gt;bus-&amp;gt;match(dev, drv) : 1;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="2320" y="1552" width="360" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="127" value="匹配后执行：&lt;div&gt;if (!dev-&amp;gt;driver) int driver_probe_device(struct device_driver *drv, struct device *dev)&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="2090" y="1613" width="470" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="128" value="同 device_register 的匹配过程" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="2320" y="1653" width="180" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="129" value="" style="shape=flexArrow;endArrow=classic;html=1;" parent="1" edge="1">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="-160" y="1105" as="sourcePoint"/>
                        <mxPoint x="-500" y="1105" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="130" value="驱动注册过程总结：" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="-720" y="1322" width="130" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="131" value="&lt;ol&gt;&lt;li&gt;检查：总线和驱动是否具有 probe, remove 以及 shutdown 函数 + 驱动是否已经挂载到总线上&lt;/li&gt;&lt;li&gt;将驱动挂载到总线上&lt;/li&gt;&lt;ol&gt;&lt;li&gt;在 priv 处理阶段，调用 kobject_init_and_add(...)，在 /sys/bus/xxx/drivers/ 下创建对应的入口&lt;/li&gt;&lt;li&gt;挂载到总线上：将驱动的 p 字段和总线的 priv 字段建立联系&lt;/li&gt;&lt;li&gt;如果总线允许自动匹配，对总线上的不具有驱动的设备进行匹配&lt;/li&gt;&lt;li&gt;将驱动添加到模块上&lt;/li&gt;&lt;li&gt;创建驱动的 sysfs 文件（uevent）&lt;/li&gt;&lt;li&gt;给驱动添加总线的驱动共有属性集（也会创建 sysfs 文件）&lt;/li&gt;&lt;li&gt;创建 unbind 和 bind 入口&lt;/li&gt;&lt;/ol&gt;&lt;li&gt;给驱动添加属性集（drv-&amp;gt;groups，也会创建 sysfs 文件）&lt;/li&gt;&lt;li&gt;向用户空间发送 uevnt - KOBJ_ADD 事件&lt;/li&gt;&lt;/ol&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;verticalAlign=middle;overflow=hidden;" parent="1" vertex="1">
                    <mxGeometry x="-720" y="1341" width="540" height="298" as="geometry"/>
                </mxCell>
                <mxCell id="132" value="补充(来自 AI 问答)：&lt;div&gt;1. bus-&amp;gt;p-&amp;gt;drivers_kset 对应 sysfs 路径：/sys/bus/&amp;lt;bus_name&amp;gt;/drivers&lt;/div&gt;&lt;div&gt;2. drv-&amp;gt;name 成为目录名 &amp;lt;drvname&amp;gt;&lt;/div&gt;&lt;div&gt;3. kobject_init_and_add() 内部调用 sysfs_create_dir() 创建目录（看源码是 create_dir）&lt;/div&gt;&lt;div&gt;4. ktype-driver_type 定义驱动的 sysfs 操作和释放函数，driver_type 在 bus.c 中已经预先定义好&lt;/div&gt;&lt;div&gt;6. 总线注册时（bus_register）会预先创建好父目录结构 /sys/bus/&amp;lt;bus-name&amp;gt;/drivers&lt;/div&gt;&lt;div&gt;7. bus_add_driver() 只是在这个已经存在的 drivers_kset 下添加一个新的 kobject，形成完整的驱动目录路径&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="-690" y="1628" width="590" height="110" as="geometry"/>
                </mxCell>
